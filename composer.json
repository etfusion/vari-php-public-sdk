{
    "name": "etfusion/vari-php-sdk",
    "description": "PHP SDK for the V-ARI Stable API (mutual TLS): identity, certificate rotation, stream metrics and custom lists.",
    "type": "library",
    "license": "MIT",
    "keywords": ["v-ari", "vari", "sdk", "api", "mtls", "etfusion"],
    "homepage": "https://github.com/etfusion/vari-php-sdk",
    "support": {
        "issues": "https://github.com/etfusion/vari-php-sdk/issues",
        "source": "https://github.com/etfusion/vari-php-sdk"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "ETFusion\\VARI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ETFusion\\VARI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
